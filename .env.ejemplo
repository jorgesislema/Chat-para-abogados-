# ============================================================
# Plantilla de variables de entorno para LegalRAG_SaaS
# Copiar este archivo como .env y completar los valores reales.
# NUNCA commitear el archivo .env real al repositorio.
# ============================================================

# Clave de API para el proveedor externo de LLM (OpenRouter).
# Obtener en https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Identificador del modelo de lenguaje a invocar via OpenRouter.
# El modelo por defecto es ligero y economico para tareas juridicas.
LLM_MODELO=meta-llama/llama-3-8b-instruct

# Secreto utilizado para firmar los tokens JWT de autenticacion.
# Debe ser una cadena aleatoria larga (recomendado 64+ caracteres).
SECRET_KEY_JWT=

# Algoritmo de firma JWT (HS256 por defecto).
ALGORITMO_JWT=HS256

# Tiempo de expiracion del token de acceso en minutos.
EXPIRACION_TOKEN_MINUTOS=60

# Cadena de conexion a la base de datos relacional (SQLite por defecto).
CADENA_BD=sqlite:///./legalrag.db

# Ruta persistente para ChromaDB (motor vectorial local).
RUTA_CHROMADB=./chromadb

# Identificador del modelo local de embeddings (sentence-transformers).
MODELO_EMBEDDINGS=sentence-transformers/all-MiniLM-L6-v2
