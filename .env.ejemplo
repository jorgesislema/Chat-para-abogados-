# ============================================================
# Plantilla de variables de entorno para LegalRAG_SaaS
# Copiar como .env y completar los valores reales:
#   cp .env.ejemplo .env   (Linux/macOS)
#   copy .env.ejemplo .env (Windows)
# NUNCA commitear el .env real. Sin SECRET_KEY_JWT valida la app
# NO arranca (fail-fast, Fase 1B).
# ============================================================

# Clave de API para el proveedor externo de LLM.
# Prioridad: LLM_API_KEY > SENSENOVA_API_KEY > SEEK_API_KEY > HMS_API_KEY > OPENROUTER_API_KEY.
# Usa SOLO una (la de tu proveedor). Los tests usan mocks y no tocan la red.
# Endpoints reales: SenseNova https://token.sensenova.ai/v1, Seek https://100milionseek.top/v1.
OPENROUTER_API_KEY=sk-or-v1-PEGAR-AQUI-TU-CLAVE
# SENSENOVA_API_KEY=PEGAR-AQUI-TU-CLAVE-SENSENOVA
# SEEK_API_KEY=PEGAR-AQUI-TU-CLAVE-SEEK

# Proveedor LLM: openrouter | sensenova | seek | hms | custom.
# Define el endpoint compatible-OpenAI y el modelo por defecto.
# Con "custom" debes fijar LLM_BASE_URL con tu gateway.
LLM_PROVEEDOR=openrouter
# LLM_BASE_URL=https://token.sensenova.ai/v1

# Modelo de lenguaje (override explicito; si se omite, default por proveedor:
# SenseNova -> SenseNova-V6-Pro, resto -> meta-llama/llama-3-8b-instruct).
LLM_MODELO=meta-llama/llama-3-8b-instruct

# Secreto para firmar JWT. OBLIGATORIO, minimo 32 caracteres.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY_JWT=PEGAR-AQUI-64-CARACTERES-ALEATORIOS

# Algoritmo de firma JWT (HS256 por defecto).
ALGORITMO_JWT=HS256

# Expiracion del token en minutos (corto por seguridad, defecto 30).
EXPIRACION_TOKEN_MINUTOS=30

# Base relacional (SQLite por defecto).
CADENA_BD=sqlite:///./backend/db/legalrag.db

# Persistencia de ChromaDB (motor vectorial local).
RUTA_CHROMADB=./backend/db/chroma_data

# Modelo local de embeddings (cambiarlo invalida los vectores: re-ingestar).
MODELO_EMBEDDINGS=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- RAG / LLM (Fase G2) ---
# Tokens maximos de respuesta (2048) y para "texto completo" (4096).
LLM_MAX_TOKENS=2048
LLM_MAX_TOKENS_TEXTO_COMPLETO=4096
# Fragmentos recuperados por consulta (presupuesto de contexto).
RAG_TOP_K=8
# Temperatura baja para citas literales de articulos.
RAG_TEMPERATURA_CITAS=0.1
# Presupuesto de contexto en caracteres (articulos completos).
RAG_PRESUPUESTO_CONTEXTO_CARACTERES=12000
# Umbrales de relevancia (permiso-aware) y contenido restringido.
RAG_UMBRAL_RELEVANCIA=0.55
RAG_UMBRAL_RESTRINGIDO=0.35
RAG_MARGEN_RESTRINGIDO=0.15
